<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.example</groupId>
    <artifactId>warehouse-demo-javafx</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>WarehousePro Demo (JavaFX)</name>

    <!-- Order matters: vaadin-app copies the packaged javafx-app jar into its applibs. -->
    <modules>
        <module>warehouse-core</module>
        <module>javafx-app</module>
        <module>vaadin-app</module>
    </modules>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <hibernate.version>6.4.4.Final</hibernate.version>
        <h2.version>2.2.224</h2.version>
        <!-- OpenJFX 21 is the LTS line for JDK 21; use 25.x on JDK 23+. -->
        <openjfx.version>21.0.8</openjfx.version>
        <swing-bridge-javafx.version>1.0.0-alpha2</swing-bridge-javafx.version>
        <!-- Swing Bridge, for the interop annotations the JavaFX app uses and the
             codegen plugin and runtime of the Vaadin app. -->
        <swing-bridge.version>1.4.0-alpha1</swing-bridge.version>
    </properties>

    <!-- SwingBridge 1.4.0-alpha1 (the annotations javafx-app uses) is a
         pre-release. -->
    <repositories>
        <repository>
            <id>vaadin-prereleases</id>
            <url>https://maven.vaadin.com/vaadin-prereleases/</url>
        </repository>
    </repositories>
    <pluginRepositories>
        <pluginRepository>
            <id>vaadin-prereleases</id>
            <url>https://maven.vaadin.com/vaadin-prereleases/</url>
        </pluginRepository>
    </pluginRepositories>
</project>
