<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>
    <groupId>com.example</groupId>
    <artifactId>warehouse-javafx-vaadin-app</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>WarehousePro in the browser (JavaFX bridge)</name>

    <properties>
        <java.version>21</java.version>
        <vaadin.version>25.3.5</vaadin.version>
        <!-- SwingBridge at the version the JavaFX extension is built against. -->
        <swing-bridge.version>1.4.0-alpha1</swing-bridge.version>
        <swing-bridge-javafx.version>1.0.0-alpha2</swing-bridge-javafx.version>
        <!-- Keep in step with the root pom: the JavaFX runtime the bridged app runs on. -->
        <openjfx.version>21.0.8</openjfx.version>
        <!-- Pin what warehouse-core is built against, over Spring Boot's managed versions. -->
        <hibernate.version>6.4.4.Final</hibernate.version>
        <h2.version>2.2.224</h2.version>

        <javafx.modules.dir>${project.build.directory}/javafx-modules-${openjfx.version}</javafx.modules.dir>
        <javafx.bridge.dir>${project.build.directory}/javafx-bridge</javafx.bridge.dir>
        <applibs.dir>${project.build.directory}/applibs</applibs.dir>
        <!-- Everything the JVM needs to run JavaFX applications through the bridge. -->
        <javafx.bridge.jvmArgs>--module-path ${javafx.modules.dir}
            --add-modules javafx.controls
            --patch-module javafx.graphics=${javafx.bridge.dir}/swing-bridge-javafx-patch.jar
            -Xbootclasspath/a:${javafx.bridge.dir}/swing-bridge-javafx-graphics.jar
            --add-reads javafx.graphics=ALL-UNNAMED,java.logging
            --add-exports=javafx.graphics/com.sun.glass.ui=ALL-UNNAMED
            --add-exports=javafx.graphics/com.sun.glass.ui.vaadin=ALL-UNNAMED
            --add-exports=javafx.graphics/com.sun.glass.events=ALL-UNNAMED
            --add-exports=javafx.graphics/com.sun.javafx.tk=ALL-UNNAMED
            --add-exports=javafx.graphics/com.sun.prism=ALL-UNNAMED
            --enable-native-access=javafx.graphics
            --add-opens=java.base/java.lang=ALL-UNNAMED
            -Dglass.platform=Vaadin
            -Dprism.order=sw
            -XX:+UseStringDeduplication</javafx.bridge.jvmArgs>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.vaadin</groupId>
                <artifactId>vaadin-bom</artifactId>
                <version>${vaadin.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Vaadin Swing Bridge (licensed separately), and the JavaFX extension. -->
        <dependency>
            <groupId>com.vaadin</groupId>
            <artifactId>swing-bridge-flow</artifactId>
            <version>${swing-bridge.version}</version>
            <!-- Swing Bridge 1.4 binds SLF4J to Log4j2, which cannot coexist
                 with Spring Boot's own logging (log4j-to-slf4j); keep Spring
                 Boot's. -->
            <exclusions>
                <exclusion>
                    <groupId>org.apache.logging.log4j</groupId>
                    <artifactId>log4j-slf4j2-impl</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.apache.logging.log4j</groupId>
                    <artifactId>log4j-core</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.vaadin.addons.componentfactory</groupId>
            <artifactId>swing-bridge-javafx-flow</artifactId>
            <version>${swing-bridge-javafx.version}</version>
        </dependency>
        <!-- The domain model and services, for the host's own views (login, modern dashboard). -->
        <dependency>
            <groupId>com.example</groupId>
            <artifactId>warehouse-core</artifactId>
            <version>3.5.0</version>
        </dependency>
        <dependency>
            <groupId>com.vaadin</groupId>
            <!-- Replace artifactId with vaadin-core to use only free components -->
            <artifactId>vaadin</artifactId>
        </dependency>
        <dependency>
            <groupId>com.vaadin</groupId>
            <artifactId>vaadin-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.vaadin</groupId>
            <artifactId>vaadin-dev</artifactId>
            <optional>true</optional>
        </dependency>
        <!--
          JavaFX runs from the module path (see javafx.bridge.jvmArgs), never from
          the class path: provided scope keeps it out of the fat jar, and the
          platform-specific jars are copied to javafx.modules.dir below.
        -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${openjfx.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <repositories>
        <!-- Vaadin Directory add-ons, for the JavaFX extension. -->
        <repository>
            <id>vaadin-addons</id>
            <url>https://maven.vaadin.com/vaadin-addons</url>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
        <repository>
            <id>vaadin-prereleases</id>
            <url>https://maven.vaadin.com/vaadin-prereleases/</url>
        </repository>
    </repositories>
    <pluginRepositories>
        <pluginRepository>
            <id>vaadin-prereleases</id>
            <url>https://maven.vaadin.com/vaadin-prereleases/</url>
        </pluginRepository>
    </pluginRepositories>

    <build>
        <defaultGoal>spring-boot:run</defaultGoal>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <!-- The platform-specific OpenJFX jars, for the module path. -->
                        <id>copy-javafx-modules</id>
                        <phase>process-resources</phase>
                        <goals><goal>copy-dependencies</goal></goals>
                        <configuration>
                            <includeGroupIds>org.openjfx</includeGroupIds>
                            <classifier>${javafx.platform}</classifier>
                            <outputDirectory>${javafx.modules.dir}</outputDirectory>
                        </configuration>
                    </execution>
                    <execution>
                        <!-- The Glass patch and the boot-class-path jar, unpacked
                             from the extension's jar. -->
                        <id>unpack-javafx-bridge</id>
                        <phase>process-resources</phase>
                        <goals><goal>unpack-dependencies</goal></goals>
                        <configuration>
                            <includeArtifactIds>swing-bridge-javafx-flow</includeArtifactIds>
                            <includes>META-INF/swing-bridge-javafx/*.jar</includes>
                            <fileMappers>
                                <org.codehaus.plexus.components.io.filemappers.FlattenFileMapper/>
                            </fileMappers>
                            <outputDirectory>${javafx.bridge.dir}</outputDirectory>
                        </configuration>
                    </execution>
                    <execution>
                        <!--
                          The JavaFX application itself goes to applibs, where the
                          bridge loads it per session. It must not be a dependency
                          of this module: on the host class path it would be shared
                          by all sessions.
                        -->
                        <id>copy-javafx-app</id>
                        <phase>process-resources</phase>
                        <goals><goal>copy</goal></goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>com.example</groupId>
                                    <artifactId>warehouse-javafx-app</artifactId>
                                    <version>3.5.0</version>
                                </artifactItem>
                            </artifactItems>
                            <outputDirectory>${applibs.dir}</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <!--
                  Swing Bridge's interop codegen, on the JavaFX app in applibs:
                  generates BridgeAppBridge, the typed interface the views call
                  BridgeApp's @ExposedMethod methods through. Runs right after
                  the jar is copied there (same phase, declared after it).
                -->
                <groupId>com.vaadin</groupId>
                <artifactId>swing-bridge-codegen-maven-plugin</artifactId>
                <version>${swing-bridge.version}</version>
                <configuration>
                    <applibsDir>${applibs.dir}</applibsDir>
                </configuration>
                <executions>
                    <execution>
                        <phase>process-resources</phase>
                        <goals><goal>generate-bridge</goal></goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.vaadin</groupId>
                <artifactId>vaadin-maven-plugin</artifactId>
                <version>${vaadin.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-frontend</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludeGroupIds>org.openjfx</excludeGroupIds>
                    <jvmArguments>${javafx.bridge.jvmArgs}
                        -Dapplibs.dir=${applibs.dir}
                        -agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=*:5006</jvmArguments>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- OpenJFX platform classifiers, as used by the OpenJFX poms themselves. -->
        <profile>
            <id>javafx-mac-aarch64</id>
            <activation><os><family>mac</family><arch>aarch64</arch></os></activation>
            <properties><javafx.platform>mac-aarch64</javafx.platform></properties>
        </profile>
        <profile>
            <id>javafx-mac-x64</id>
            <activation><os><family>mac</family><arch>x86_64</arch></os></activation>
            <properties><javafx.platform>mac</javafx.platform></properties>
        </profile>
        <profile>
            <id>javafx-linux-x64</id>
            <activation><os><family>unix</family><name>linux</name><arch>amd64</arch></os></activation>
            <properties><javafx.platform>linux</javafx.platform></properties>
        </profile>
        <profile>
            <id>javafx-linux-aarch64</id>
            <activation><os><family>unix</family><name>linux</name><arch>aarch64</arch></os></activation>
            <properties><javafx.platform>linux-aarch64</javafx.platform></properties>
        </profile>
        <profile>
            <id>javafx-win</id>
            <activation><os><family>windows</family></os></activation>
            <properties><javafx.platform>win</javafx.platform></properties>
        </profile>

        <profile>
            <id>production</id>
            <dependencies>
                <dependency>
                    <groupId>com.vaadin</groupId>
                    <artifactId>vaadin-core</artifactId>
                    <exclusions>
                        <exclusion>
                            <groupId>com.vaadin</groupId>
                            <artifactId>vaadin-dev</artifactId>
                        </exclusion>
                    </exclusions>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.vaadin</groupId>
                        <artifactId>vaadin-maven-plugin</artifactId>
                        <version>${vaadin.version}</version>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>build-frontend</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
